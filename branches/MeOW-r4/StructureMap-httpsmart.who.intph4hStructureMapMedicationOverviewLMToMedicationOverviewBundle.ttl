  fhir:date [ fhir:v "2026-06-24T12:43:15+00:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "WHO"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "WHO" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "http://who.int" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "All LMs and profiles come from IHE Pharm MEOW (r4 branch). Local copies were\r\ndeleted on this branch."] ; # 
  fhir:structure ( [
